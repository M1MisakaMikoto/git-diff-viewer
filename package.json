{
  "name": "git-diff-viewer",
  "displayName": "Git Diff Viewer",
  "description": "按目录浏览完整 Git 项目树与版本差异，并直接打开原生 diff 编辑器。",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M1MisakaMikoto/git-diff-viewer.git"
  },
  "homepage": "https://github.com/M1MisakaMikoto/git-diff-viewer#readme",
  "bugs": {
    "url": "https://github.com/M1MisakaMikoto/git-diff-viewer/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "diff",
    "compare",
    "version",
    "scm"
  ],
  "activationEvents": [
    "onView:gitDiffViewer.changes"
  ],
  "main": "./out/src/extension.js",
  "files": [
    "out/src",
    "media",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "~1.85.0",
    "typescript": "^5.6.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitDiffViewer",
          "title": "Git 版本对比",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitDiffViewer": [
        {
          "id": "gitDiffViewer.changes",
          "name": "版本差异",
          "icon": "media/icon.svg",
          "contextualTitle": "Git 版本对比"
        }
      ]
    },
    "commands": [
      {
        "command": "gitDiffViewer.refresh",
        "title": "刷新",
        "category": "Git 版本对比",
        "icon": "$(refresh)"
      },
      {
        "command": "gitDiffViewer.chooseRepository",
        "title": "选择仓库",
        "category": "Git 版本对比",
        "icon": "$(repo)"
      },
      {
        "command": "gitDiffViewer.setupCodex",
        "title": "配置 Codex 集成",
        "category": "Git 版本对比",
        "icon": "$(plug)"
      },
      {
        "command": "gitDiffViewer.chooseComparison",
        "title": "选择对比范围",
        "category": "Git 版本对比",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitDiffViewer.compareHead",
        "title": "工作区与 HEAD 对比",
        "category": "Git 版本对比"
      },
      {
        "command": "gitDiffViewer.compareWithVersion",
        "title": "工作区与指定版本对比",
        "category": "Git 版本对比"
      },
      {
        "command": "gitDiffViewer.compareVersions",
        "title": "两个版本对比",
        "category": "Git 版本对比"
      },
      {
        "command": "gitDiffViewer.compareIndex",
        "title": "暂存区与工作区对比",
        "category": "Git 版本对比"
      },
      {
        "command": "gitDiffViewer.openDiff",
        "title": "打开差异",
        "category": "Git 版本对比",
        "icon": "$(diff)"
      },
      {
        "command": "gitDiffViewer.openFile",
        "title": "打开文件",
        "category": "Git 版本对比",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitDiffViewer.copyPath",
        "title": "复制相对路径",
        "category": "Git 版本对比"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitDiffViewer.setupCodex",
          "when": "view == gitDiffViewer.changes && !gitDiffViewer.codexConfigured",
          "group": "navigation@0"
        },
        {
          "command": "gitDiffViewer.chooseRepository",
          "when": "view == gitDiffViewer.changes && gitDiffViewer.hasRepository",
          "group": "navigation@1"
        },
        {
          "command": "gitDiffViewer.chooseComparison",
          "when": "view == gitDiffViewer.changes",
          "group": "navigation@2"
        },
        {
          "command": "gitDiffViewer.refresh",
          "when": "view == gitDiffViewer.changes",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "gitDiffViewer.openDiff",
          "when": "view == gitDiffViewer.changes && viewItem == gitDiffViewer.changedFile",
          "group": "inline@1"
        },
        {
          "command": "gitDiffViewer.openFile",
          "when": "view == gitDiffViewer.changes && (viewItem == gitDiffViewer.file || viewItem == gitDiffViewer.changedFile)",
          "group": "inline@2"
        },
        {
          "command": "gitDiffViewer.openDiff",
          "when": "view == gitDiffViewer.changes && viewItem == gitDiffViewer.changedFile",
          "group": "1_open@1"
        },
        {
          "command": "gitDiffViewer.openFile",
          "when": "view == gitDiffViewer.changes && (viewItem == gitDiffViewer.file || viewItem == gitDiffViewer.changedFile)",
          "group": "1_open@2"
        },
        {
          "command": "gitDiffViewer.copyPath",
          "when": "view == gitDiffViewer.changes && (viewItem == gitDiffViewer.file || viewItem == gitDiffViewer.changedFile)",
          "group": "2_copy@1"
        },
        {
          "command": "gitDiffViewer.chooseComparison",
          "when": "view == gitDiffViewer.changes && viewItem == gitDiffViewer.repository",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitDiffViewer.openDiff",
          "when": "false"
        },
        {
          "command": "gitDiffViewer.openFile",
          "when": "false"
        },
        {
          "command": "gitDiffViewer.copyPath",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Git 版本对比",
      "properties": {
        "gitDiffViewer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "文件保存或工作区文件变化后自动刷新差异。"
        },
        "gitDiffViewer.repositorySearchDepth": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "在工作区目录中搜索嵌套 Git 仓库的最大目录深度。"
        }
      }
    }
  }
}
